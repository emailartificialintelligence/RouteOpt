# Production settings for the docker-compose stack. Copy to .env on the VM:
#     cp .env.production.example .env
# then edit. Compose reads .env automatically.

# --- required -------------------------------------------------------------

# The domain pointing at this machine. Caddy gets a TLS certificate for it.
DOMAIN=routes.example.com

# Nominatim and Photon both want to know who is calling. Use a real address or
# a project URL — Nominatim returns 403, not an empty result, without one.
GEOCODER_USER_AGENT=RoutePlan/1.0 (you@example.com)

# Must match the region name printed by scripts/prepare-osrm.sh
OSRM_REGION=monaco-latest

# --- optional -------------------------------------------------------------

# "photon" has no per-second limit and needs no key. Prefer it in production.
GEOCODER_PROVIDER=photon
GEOCODER_BASE_URL=https://photon.komoot.io

# Self-hosted OSRM can serve far larger tables than the public demo's 100.
# Raising this lets you raise MAX_STOPS in src/lib/schema.ts — but a table is
# N-squared work, so 1000 coordinates is 1,000,000 cells.
OSRM_MAX_TABLE_SIZE=1000

# Per IP, per minute.
RATE_LIMIT_SOLVE=20
RATE_LIMIT_GEOCODE=60
