# Public OSRM demo server is rate-limited and NOT for production.
# Self-host before launch:
#   docker run -p 5000:5000 -v "$PWD/data:/data" osrm/osrm-backend \
#     osrm-routed --algorithm mld /data/region.osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000

# Which geocoder. "photon" has no per-second rule and needs no key, which makes
# it the sensible choice for anything deployed; "nominatim" is the default and
# is development-only in practice.
#   GEOCODER_PROVIDER=photon
GEOCODER_PROVIDER=nominatim

# Nominatim usage policy requires a real contact address and 1 req/sec.
#
# The User-Agent is not optional: Nominatim answers 403, not 200-with-no-results,
# when it cannot attribute a request, and it rejects obvious placeholders. Either
# an email or a project URL counts as contact. Put your own here.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=RoutePlan/0.1 (+https://github.com/your-org/routeplan)
GEOCODER_TIMEOUT_MS=8000

# Nominatim allows one request per second. Lower this only against your own
# instance; against the public one it will get you blocked.
GEOCODER_SPACING_MS=1100

# OR-Tools sidecar (Phase 5). Unset means the Balanced engine is offered as
# "not set up" rather than failing on every request.
#   pip install ortools && python sidecar/solver.py
ORTOOLS_URL=http://127.0.0.1:8081
ORTOOLS_TIMEOUT_MS=30000

# Rate limiting (per IP, per minute). Process-local: move rate-limit.ts to Redis
# before running more than one instance, or each replica allows the full quota.
# Only set TRUST_PROXY when a proxy really is in front — x-forwarded-for is
# trivially spoofed, and trusting it without one hands anyone an endless quota.
TRUST_PROXY=false
RATE_LIMIT_SOLVE=20
RATE_LIMIT_GEOCODE=60
RATE_LIMIT_GEOMETRY=60
RATE_LIMIT_SHARE=60
